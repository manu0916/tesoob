# Copie para backend/.env (ignorado pelo Git). Gere valores próprios antes de subir.
DB_URL=jdbc:postgresql://localhost:5432/tesoob_store
DB_USER=tesoob
DB_PASSWORD=
STORE_AES_KEY=
STORE_ACTIVE_KEY=v1
STORE_ADMIN_EMAIL=
STORE_ADMIN_PASSWORD_HASH=
# false APENAS para HTTP em localhost; produção exige HTTPS e true.
COOKIE_SECURE=false
# Ative somente após configurar um OAuth Web Client no Google Cloud:
SPRING_PROFILES_ACTIVE=default
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/store-api/login/oauth2/code/google
